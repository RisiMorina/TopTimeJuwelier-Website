{
  "permissions": {
    "allow": [
      "Bash(which playwright-cli *)",
      "Read(//c/Users/risim/AppData/Local/ms-playwright/**)",
      "Bash(playwright-cli resize *)",
      "Bash(playwright-cli goto *)",
      "Bash(playwright-cli eval *)",
      "Bash(playwright-cli screenshot *)",
      "Bash(playwright-cli console *)",
      "Bash(playwright-cli reload *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\risim\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\risim\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\risim\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\risim\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
